<TargetEndpoint name="booking-and-referral-target">
  <Flows>
    <Flow name="Main">
      <Request>
        <Step>
          <Name>Python.DecodeBase64</Name>
        </Step>
        <Step>
          <Name>Javascript.CheckTarget</Name>
        </Step>
        <Step>
          <Name>RaiseFault.400MalformedTargetIdentifier</Name>
          <Condition>idMalformed = true</Condition>
        </Step>
        <Step>
          <Name>KVM.GetEpcConfig</Name>
        </Step>
        <Step>
          <Name>Python.DecodeEndUserOrg</Name>
        </Step>
        <Step>
          <Name>Javascript.BuildEpcPath</Name>
        </Step>
        <Step>
          <Name>AM.PrepareEpcRequest</Name>
        </Step>
        <Step>
          <Name>SC.CallEpc</Name>
        </Step>
        <Step>
          <Name>Javascript.ParseEpcResponse</Name>
        </Step>
        <Step>
          <Name>RaiseFault.404ProxyNotFound</Name>
          <Condition>isError = true</Condition>
        </Step>
        <Step>
          <Name>RaiseFault.503EpcUnavailable</Name>
          <Condition>epcUnavailable = true</Condition>
        </Step>
        <Step>
          <Name>RaiseFault.500EpcInvalidResponse</Name>
          <Condition>epcInvalidResponse = true</Condition>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>
  <DefaultFaultRule>
    <Step>
      <Name>ExtractVariables.OperationOutcomeCode</Name>
    </Step>
    <Step>
      <Name>Javascript.HandleErrors</Name>
    </Step>
    <Step>
      <Name>AssignMessage.SetErrorResponse</Name>
    </Step>
  </DefaultFaultRule>
  <HTTPTargetConnection>
        <Properties>
            <Property name="io.timeout.millis">32000</Property>
        </Properties>
    <URL>https://mocktarget.apigee.net</URL>
    <SSLInfo>
      <Enabled>true</Enabled>
      <ClientAuthEnabled>true</ClientAuthEnabled>
      <KeyStore>ref://bars-client</KeyStore>
      <KeyAlias>cert</KeyAlias>
    </SSLInfo>
  </HTTPTargetConnection>
</TargetEndpoint>
